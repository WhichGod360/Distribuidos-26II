--llamen a la bd : distribuidos-II
-- 1. Tabla RolUsuario
CREATE TABLE RolUsuario (
    id_rol_usuario INT IDENTITY(1,1) PRIMARY KEY,
    nombre_rol_usuario VARCHAR(50) NOT NULL
);
GO

-- 2. Tabla Usuario
CREATE TABLE Usuario (
    id_usuario INT IDENTITY(1,1) PRIMARY KEY,
    email_usuario VARCHAR(100) NOT NULL UNIQUE,
    nombre_usuario VARCHAR(100) NOT NULL,
    ap_paterno VARCHAR(100)  NOT NULL,
    ap_materno VARCHAR(100)  NOT NULL,
    numero_dni_usuario VARCHAR(8) NOT NULL UNIQUE,
    fecha_nacimiento_usuario DATE NULL,
    genero_usuario BIT NULL, 
    estado_usuario VARCHAR(30) NOT NULL,
    contrasena VARCHAR(255) NOT NULL,
    id_rol_usuario INT NOT NULL,
    CONSTRAINT FK_Usuario_Rol FOREIGN KEY (id_rol_usuario) REFERENCES RolUsuario(id_rol_usuario)
);
GO

-- 3. Tabla Autor
CREATE TABLE Autor (
    id_autor INT IDENTITY(1,1) PRIMARY KEY, 
    nombre_autor VARCHAR(255) NOT NULL
);
GO

-- 4. Tabla Libro
CREATE TABLE Libro (
    id_libro INT IDENTITY(1,1) PRIMARY KEY,
    titulo_libro VARCHAR(255) NOT NULL,
    editorial_libro VARCHAR(255) NULL, 
    ano_publicacion SMALLINT NULL,
    stock_total INT NOT NULL DEFAULT 0,
    estado_libro BIT NOT NULL DEFAULT 1,
    publico_libro VARCHAR(30) NULL
);
GO

-- 5. Tabla DetalleLibro (Relación N:M Libro - Autor con restricción de unicidad)
CREATE TABLE DetalleLibro (
    id_detalle_libro INT IDENTITY(1,1) PRIMARY KEY,
    id_libro INT NOT NULL,
    id_autor INT NOT NULL,
    CONSTRAINT FK_DetalleLibro_Libro FOREIGN KEY (id_libro) REFERENCES Libro(id_libro),
    CONSTRAINT FK_DetalleLibro_Autor FOREIGN KEY (id_autor) REFERENCES Autor(id_autor),
    CONSTRAINT UQ_Libro_Autor UNIQUE (id_libro, id_autor)
);
GO

-- 6. Tabla Categoria
CREATE TABLE Categoria (
    id_categoria INT IDENTITY(1,1) PRIMARY KEY,
    nombre_categoria VARCHAR(30) NOT NULL
);
GO

-- 7. Tabla DetalleCategoria (Relación N:M Libro - Categoria con restricción de unicidad)
CREATE TABLE DetalleCategoria (
    id_detalleCategoria INT IDENTITY(1,1) PRIMARY KEY,
    id_libro INT NOT NULL,
    id_categoria INT NOT NULL,
    CONSTRAINT FK_DetalleCategoria_Libro FOREIGN KEY (id_libro) REFERENCES Libro(id_libro),
    CONSTRAINT FK_DetalleCategoria_Categoria FOREIGN KEY (id_categoria) REFERENCES Categoria(id_categoria),
    CONSTRAINT UQ_Libro_Categoria UNIQUE (id_libro, id_categoria)
);
GO

-- 8. Tabla Ejemplar
CREATE TABLE Ejemplar (
    id_ejemplar INT IDENTITY(1,1) PRIMARY KEY,
    estado_ejemplar BIT NOT NULL DEFAULT 1, 
    id_libro INT NOT NULL,
    CONSTRAINT FK_Ejemplar_Libro FOREIGN KEY (id_libro) REFERENCES Libro(id_libro)
);
GO

-- 9. Tabla Prestamo
CREATE TABLE Prestamo (
    id_prestamo INT IDENTITY(1,1) PRIMARY KEY,
    fecha_inicio_prestamo DATE NOT NULL,
    fecha_fin_prestamo DATE NOT NULL,
    fecha_retorno_prestamo DATE NULL, 
    estado_prestamo VARCHAR(30) NOT NULL,
    dias_retraso_prestamo INT DEFAULT 0,
    id_usuario INT NOT NULL,
    id_bibliotecario INT NOT NULL,
    id_ejemplar INT NOT NULL,
    CONSTRAINT FK_Prestamo_Usuario FOREIGN KEY (id_usuario) REFERENCES Usuario(id_usuario),
    CONSTRAINT FK_Prestamo_Bibliotecario FOREIGN KEY (id_bibliotecario) REFERENCES Usuario(id_usuario),
    CONSTRAINT FK_Prestamo_Ejemplar FOREIGN KEY (id_ejemplar) REFERENCES Ejemplar(id_ejemplar),
    CONSTRAINT CHK_Prestamo_Fechas CHECK (fecha_fin_prestamo > fecha_inicio_prestamo)
);
GO

-- 10. Tabla Penalizacion
CREATE TABLE Penalizacion (
    id_penalizacion INT IDENTITY(1,1) PRIMARY KEY,
    tipo_penalizacion VARCHAR(30) NOT NULL,
    descripcion_penalizacion VARCHAR(MAX) NULL,
    monto_penalizacion DECIMAL(7,2) NOT NULL DEFAULT 0.00,
    estado_penalizacion BIT NOT NULL DEFAULT 1, 
    CONSTRAINT CHK_Penalizacion_Monto  CHECK (Monto_Penalizacion >= 0)
);
GO

-- 11. Tabla DetallePenalizacion
CREATE TABLE DetallePenalizacion (
    id_detalle_penalizacion INT IDENTITY(1,1) PRIMARY KEY,
    descripcion_detallepenalizacion VARCHAR(MAX) NULL,
    id_penalizacion INT NOT NULL,
    id_prestamo INT NOT NULL,
    CONSTRAINT FK_DetallePenalizacion_Penalizacion FOREIGN KEY (id_penalizacion) REFERENCES Penalizacion(id_penalizacion),
    CONSTRAINT FK_DetallePenalizacion_Prestamo FOREIGN KEY (id_prestamo) REFERENCES Prestamo(id_prestamo)
);
GO


