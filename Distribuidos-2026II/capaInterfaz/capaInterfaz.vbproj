    <EmbeddedResource Update="frmAgregarCategoria.resx"><DependentUpon>frmAgregarCategoria.vb</DependentUpon></EmbeddedResource>
    <Compile Update="frmAutor.vb"><SubType>Form</SubType></Compile>
    <Compile Update="frmAutor.Designer.vb"><DependentUpon>frmAutor.vb</DependentUpon></Compile>
