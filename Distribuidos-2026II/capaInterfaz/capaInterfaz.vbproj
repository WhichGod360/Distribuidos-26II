<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>capaInterfaz</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <StartupObject>capaInterfaz.Login</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <ImportedNamespaces>System.ComponentModel=False,System.Data=False,System.Drawing=False,System.Windows.Forms=False,Microsoft.VisualBasic=True,System=True,System.Collections=True,System.Collections.Generic=True,System.Diagnostics=True,System.Linq=True,System.Xml.Linq=True,System.Threading.Tasks=True,capaInterfaz=True</ImportedNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.ComponentModel" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\capaNegocio\capaNegocio.vbproj" />
    <ProjectReference Include="..\capaDatos\capaDatos.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Utiles\DataGridViewHelper.vb" Link="Utiles\DataGridViewHelper.vb" />
    <Compile Include="..\Utiles\MantenimientoUI.vb" Link="Utiles\MantenimientoUI.vb" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Compile Update="frmAgregarCategoria.vb"><SubType>Form</SubType></Compile>
